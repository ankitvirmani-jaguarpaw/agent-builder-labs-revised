GOOGLE_CLOUD_PROJECT=your-qwiklabs-project-id
GOOGLE_CLOUD_LOCATION=global
MANAGED_BASE_AGENT=antigravity-preview-05-2026
# Optional: override skill staging GCS bucket (defaults to <PROJECT_ID>-managed-agent-skills)
# AGENT_SKILL_GCS_BUCKET=your-qwiklabs-project-id-managed-agent-skills
# Optional: override base model or per-turn token budget on the Managed Agent
# MANAGED_AGENT_MODEL=gemini-3.8-flash
# MANAGED_AGENT_MAX_TOKENS=65536
# Optional: attach Cloud Run Knowledge Catalog MCP server if deployed in the same project
# CATALOG_MCP_URL=https://knowledge-catalog-mcp-<hash>-uc.a.run.app/sse
